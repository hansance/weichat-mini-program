/* pages/order/order.wxss */
.page-title {
  font-size: 36rpx;
  font-weight: bold;
  padding: 20rpx 0 30rpx;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  font-size: 26rpx;
  font-weight: bold;
}

.order-body {
  padding: 20rpx 0;
}

.order-service {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.order-info {
  display: flex;
  gap: 30rpx;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.order-address {
  font-size: 24rpx;
  color: #666;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.order-amount {
  font-size: 34rpx;
  color: #e74c3c;
  font-weight: bold;
}

.btn-cancel {
  font-size: 24rpx;
  color: #999;
  border: 1rpx solid #ddd;
  background: #fff;
}

.empty {
  text-align: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}
