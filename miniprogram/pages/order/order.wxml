<!--pages/order/order.wxml-->
<view class="container">
  <view class="page-title">我的订单</view>

  <view class="order-list">
    <view wx:for="{{orderList}}" wx:key="id" class="order-card">
      <view class="order-header">
        <text class="order-no">订单号：{{item.orderNo}}</text>
        <text class="order-status" style="color: {{statusColorMap[item.status]}}">
          {{statusMap[item.status]}}
        </text>
      </view>

      <view class="order-body">
        <view class="order-service">{{item.serviceName}}</view>
        <view class="order-info">
          <text>联系人：{{item.contactName}}</text>
          <text>电话：{{item.contactPhone}}</text>
        </view>
        <view class="order-address">地址：{{item.address}}</view>
      </view>

      <view class="order-footer">
        <text class="order-amount">¥{{item.amount}}</text>
        <view class="order-actions" wx:if="{{item.status === 0}}">
          <button
            class="btn-pay"
            size="mini"
            type="primary"
            bindtap="payOrder"
            data-id="{{item.id}}">
            去支付
          </button>
          <button
            class="btn-cancel"
            size="mini"
            bindtap="cancelOrder"
            data-id="{{item.id}}">
            取消订单
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{orderList.length === 0}}" class="empty">
    <text>暂无订单</text>
  </view>
</view>
